# Arc & Grain local environment example
#
# Copy this file to apps/api/.dev.vars before starting the Worker:
#   cp .env.example apps/api/.dev.vars
#
# The values below are safe placeholders for local UI/API development only.
# Generate unique secrets for any shared or production environment with:
#   openssl rand -base64 32

# Signed cursor integrity
CURSOR_SECRET="local-only-cursor-secret-replace-me"

# Gallery PIN and client-IP hardening
PIN_PEPPER="local-only-pin-pepper-replace-me"
IP_HASH_PEPPER="local-only-ip-pepper-replace-me"

# Supabase Postgres. For a hosted project, copy the Transaction pooler URI
# (port 6543) from Dashboard > Connect. Prepared statements are disabled by the app.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Supabase API and private Storage bucket. Keep the service-role key server-only.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="photos-originals"

# These defaults also live in apps/api/wrangler.toml. Keeping them here makes
# the complete runtime configuration visible in one example file.
PUBLIC_ORIGIN="http://localhost:5173"
DOCS_ENABLED="true"
